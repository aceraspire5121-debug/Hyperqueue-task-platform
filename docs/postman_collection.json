{
  "info": {
    "name": "hyperqueue.io - Task Automation Platform APIs",
    "description": "Postman API Collection for testing MERN/Full Stack Technical Assessment endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Service Health Check",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Candidate\",\n  \"email\": \"test@hyperqueue.io\",\n  \"password\": \"TestPass123!\",\n  \"role\": \"USER\"\n}"
            },
            "url": "http://localhost:5000/api/v1/auth/register"
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@hyperqueue.io\",\n  \"password\": \"UserPassword123!\"\n}"
            },
            "url": "http://localhost:5000/api/v1/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "http://localhost:5000/api/v1/auth/refresh-token"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create & Queue Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Generate Analytics PDF\",\n  \"description\": \"Weekly data aggregation job\",\n  \"priority\": \"HIGH\"\n}"
            },
            "url": "http://localhost:5000/api/v1/tasks"
          }
        },
        {
          "name": "Get Tasks (Search, Filter, Pagination)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "http://localhost:5000/api/v1/tasks?search=analytics&status=PENDING&page=1&limit=10"
          }
        },
        {
          "name": "Get Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "http://localhost:5000/api/v1/tasks/metrics"
          }
        },
        {
          "name": "Get Task By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "http://localhost:5000/api/v1/tasks/:taskId"
          }
        },
        {
          "name": "Update Task Details",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Task Title\",\n  \"description\": \"Updated Description\",\n  \"priority\": \"URGENT\"\n}"
            },
            "url": "http://localhost:5000/api/v1/tasks/:taskId"
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "http://localhost:5000/api/v1/tasks/:taskId"
          }
        },
        {
          "name": "Retry Failed Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "http://localhost:5000/api/v1/tasks/:taskId/retry"
          }
        },
        {
          "name": "Get Task Audit Logs Timeline",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "http://localhost:5000/api/v1/tasks/:taskId/logs"
          }
        }
      ]
    }
  ]
}
