{
  "info": {
    "name": "Saarthi AI - Task Automation Platform APIs",
    "description": "Postman API Collection for testing MERN/Full Stack Technical Assessment endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Candidate\",\n  \"email\": \"test@saarthi.ai\",\n  \"password\": \"TestPass123!\",\n  \"role\": \"USER\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/auth/register" }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@saarthi.ai\",\n  \"password\": \"UserPassword123!\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/auth/login" }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/auth/refresh-token" }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create & Queue Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Generate Analytics PDF\",\n  \"description\": \"Weekly data aggregation job\",\n  \"priority\": \"HIGH\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/tasks" }
          }
        },
        {
          "name": "Get Tasks (Search, Filter, Pagination)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "http://localhost:5000/api/v1/tasks?search=analytics&status=PENDING&page=1&limit=10" }
          }
        },
        {
          "name": "Get Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "http://localhost:5000/api/v1/tasks/metrics" }
          }
        },
        {
          "name": "Retry Failed Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "http://localhost:5000/api/v1/tasks/:taskId/retry" }
          }
        }
      ]
    }
  ]
}
